# PostgreSQL connection string (docker-compose.yml at the repo root exposes Postgres on 5432)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/expense_splitter?schema=public"

# Port the API listens on
PORT=4000

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed by CORS
CORS_ORIGIN="http://localhost:3000"
